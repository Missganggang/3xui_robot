[Unit]
Description=3x-ui deployment and migration console
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=xui-console
Group=xui-console
WorkingDirectory=/opt/3xui-console/current
EnvironmentFile=/etc/3xui-console.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/3xui-console/venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 18080 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/3xui-console
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
