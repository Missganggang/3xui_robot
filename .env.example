# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATA_DIR=./data
# Production requires HTTPS and secure cookies. For http://127.0.0.1 only, use false.
COOKIE_SECURE=true
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_WORKER=true
MAX_CONCURRENT_JOBS=2
# Keep false on a public website. Only enable for an isolated trusted network.
ALLOW_PRIVATE_TARGETS=false
UPLOAD_RETENTION_HOURS=24
